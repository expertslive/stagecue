{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(local);Database=EventStageTimer;Integrated Security=true;TrustServerCertificate=true"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@example.com",
    "FromName": "Stagecue"
  },
  "Security": {
    "PublicRateLimit": {
      "RequestsPerSecond": 10,
      "BurstSize": 30,
      "CooldownSeconds": 60
    }
  },
  "Storage": {
    "Local": { "Root": "./uploads" }
  },
  "App": { "BaseUrl": "" }
}
