# Copy to `.env` and adjust before running the event-day stack.
# `docker compose` reads this file automatically.

# Strong password for the bundled SQL Server `sa` account.
# Must satisfy SQL Server complexity: 8+ chars with upper, lower, digit, symbol.
SA_PASSWORD=ChangeMe_For_The_Event_2026!

# Public base URL of the running stack. Use the laptop's LAN IP so confidence
# monitors and door tablets on the same Wi-Fi can hit the speaker / door / lobby
# URLs printed on the QR codes.
#
# Example:    APP_BASE_URL=http://192.168.0.10:8080
APP_BASE_URL=http://localhost:8080
