# Stagecue self-hosted environment.
# Copy to `.env` and edit before `docker compose up`.

# Strong password for the bundled SQL Server `sa` account.
# SQL Server complexity rule: 8+ chars with upper, lower, digit, and symbol.
SA_PASSWORD=ChangeMe_For_The_Event_2026!

# Public URL the app advertises. This must be reachable by audience devices
# (speaker laptops, door tablets, lobby TVs) — they hit URLs encoded in the
# QR codes. For an offline event use the host's LAN IP.
#
#   Example:    APP_BASE_URL=http://192.168.0.10:8080
APP_BASE_URL=http://localhost:8080

# Optional — pin a specific image version. Defaults to `latest`.
# Available tags: https://github.com/expertslive/stagecue/pkgs/container/stagecue
# STAGECUE_TAG=v0.1.0

# Optional — change the host port the app listens on. Defaults to 8080.
# APP_PORT=8080
